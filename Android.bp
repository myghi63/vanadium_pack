package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Name placeholder for 'webview'.
//
// build/make/target/product/media_product.mk keeps 'webview' in PRODUCT_PACKAGES, and a
// name inherited that way cannot be dropped from a child mk (node_fns.mk freezes a
// per-file snapshot of PRODUCT_PACKAGES and re-injects the inherited literals when it
// expands the @inherit: tags). The manifest drops the five chromium-webview projects, so
// nothing else defines the name any more and the packaging check enabled by
// vendor/lineage/config/common.mk (enforce-product-packages-exist) fails on it. The
// allow-list is not an option here: PRODUCT_ENFORCE_PACKAGES_EXIST_ALLOW_LIST is not an
// inherited product var, it exists only as a read-only PRODUCTS.<product mk> value that
// vendor/lineage/config/common.mk already froze for this product.
//
// A header-only cc module is exported to Make (so the name resolves) and installs nothing
// (no rule in out/soong/installs-<product>.mk), which keeps the Chromium apk out of the
// image. The WebView provider apk itself is TrichromeWebViewDualArch from vendor/vanadium,
// packaged by vanadium_pack.mk.
cc_library_headers {
    name: "webview",
    product_specific: true,

    export_include_dirs: ["."],
}
