// The 'webview' module media_product.mk always packages, provided here as the
// GrapheneOS Vanadium WebView prebuilt. The vanilla Lineage chromium-webview
// projects are dropped from the build through remove-project entries in the
// device manifest; this module is what keeps the packaging reference alive.
// The apk is a symlink to the provider repo at vendor/vanadium so the payload
// is never copied (vendor/ is what AdServices visibility already grants).
android_app_import {
    name: "webview",
    product_specific: true,

    optional_uses_libs: [
        "android.test.base",
        "androidx.window.extensions",
        "android.ext.adservices",
    ],

    required: [
        "VanadiumConfig",
    ],

    apk: "VanadiumWebView.apk",

    // The apk is already aligned and signed by GrapheneOS. presigned (not
    // preprocessed) on purpose: preprocessed copies the apk with cp, which for
    // the symlink above stored a broken relative symlink in out; presigned runs
    // zipalign through the resolved file and writes a real apk (signature
    // preserved, the .idsig stays unused for /product).
    presigned: true,
}
