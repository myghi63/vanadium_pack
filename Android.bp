// Name shim only: media_product.mk always packages the 'webview' module, and
// the vanilla Lineage chromium-webview projects are dropped from the build
// through remove-project entries in the device manifest. The actual provider
// is vendor/vanadium's TrichromeWebViewDualArch (android_app_import,
// product_specific, preprocessed with the GrapheneOS signature intact,
// arm64), packaged directly by vanadium_pack.mk; it installs the apk and
// brings VanadiumConfig and the loader libs through its own required list.
// (A local android_app_import of the apk is not possible here: sbox/CpRule
// stage symlinked sources verbatim, producing broken links in out/.)
filegroup {
    name: "webview",
    srcs: [":TrichromeWebViewDualArch"],
}
