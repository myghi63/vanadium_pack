// Shim module for the 'webview' name media_product.mk always packages (the
// vanilla chromium prebuilt is dropped from the build through remove-project
// entries in the device manifest, so without a module the make existence
// check errors). installable: false: the actual WebView provider is
// vendor/vanadium's TrichromeWebViewDualArch, packaged directly by
// vanadium_pack.mk (preprocessed, GrapheneOS signature intact, required
// VanadiumConfig + loader libs). The apk content here is irrelevant because
// this module is never installed; it points at the small VanadiumConfig
// prebuilt to avoid copying the WebView apk for nothing.
//
// overrides: ["Jelly"] is the removal mechanism: vendor/lineage/config/
// common.mk packages Jelly, and make inheritance freezes per-file snapshots
// (build/make/core/node_fns.mk), so no PRODUCT_PACKAGES filter-out can undo
// an inherited entry. A module reference to Jelly resolves to this shim and
// nothing is installed in its place -> the package disappears from the
// image. Only applies when this pack is in the build.
android_app_import {
    name: "webview",
    product_specific: true,
    installable: false,

    overrides: [
        "Jelly",
    ],

    apk: ":VanadiumConfig",
    preprocessed: true,
}
