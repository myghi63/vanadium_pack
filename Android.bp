// The 'webview' module media_product.mk always packages, provided here as the
// GrapheneOS Vanadium WebView prebuilt. The vanilla Lineage chromium-webview
// projects are dropped from the build through remove-project entries in the
// device manifest; this module is what keeps the packaging reference alive.
// The apk is a symlink to the provider repo at vendor/vanadium so the payload
// is never copied in the repo.

// Materialize the symlink as a regular file: a preprocessed import stages the
// apk with cp, which preserves the symlink itself and left a broken relative
// link in the product staging dir.
genrule {
    name: "vanadium_webview_copy",
    srcs: ["VanadiumWebView.apk"],
    out: ["webview_copy.apk"],
    cmd: "cp $(in) $(out)",
}

android_app_import {
    name: "webview",
    product_specific: true,

    optional_uses_libs: [
        "android.test.base",
        "androidx.window.extensions",
        "android.ext.adservices",
    ],

    required: [
        "VanadiumConfig",
    ],

    apk: ":vanadium_webview_copy",

    // Presigned apks with targetSdkVersion >= 30 must be preprocessed:
    // zipalign would wreck the v2/v3 signature GrapheneOS signed them with.
    preprocessed: true,
}
